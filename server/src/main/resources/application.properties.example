spring.application.name=jira
spring.mongodb.uri=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@your-cluster.mongodb.net/your-db-name?retryWrites=true&w=majority
jwt.secret=change-this-to-a-random-32-plus-character-string
brevo.api.key=YOUR_BREVO_API_KEY
brevo.sender.email=your-verified-sender@yourdomain.com
brevo.sender.name=Jira Clone
app.frontend-url=http://localhost:3000